{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-sonnet-4-6",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(pwd)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(make:*)",
      "Bash(./verify.sh)",
      "Bash(./test.sh)",
      "Bash(scripts/bootstrap.sh)",
      "Bash(scripts/install-deps.sh)",
      "Bash(scripts/dev-up.sh)",
      "Bash(scripts/dev-down.sh)",
      "Bash(scripts/run-demo.sh)",
      "Bash(scripts/check-no-secrets.sh:*)",
      "Bash(scripts/k8s-smoke-test.sh:*)",
      "Bash(python3 scripts/validate_schemas.py)",
      "Bash(python3 scripts/generate-scenarios.py:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(kustomize build:*)",
      "Bash(helm template:*)",
      "Bash(kubectl apply --dry-run=client:*)",
      "Bash(kubectl get:*)",
      "Bash(docker compose:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run test:*)",
      "Bash(npx vitest run:*)",
      "Bash(gh api:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git checkout main)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git tag:*)",
      "Bash(npm install:*)",
      "Bash(pip install:*)",
      "Bash(docker build:*)",
      "Bash(docker push:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(kind create:*)",
      "Bash(kind delete:*)",
      "Bash(helm install:*)",
      "Bash(helm upgrade:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(rm:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git config:*)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "WebFetch(domain:*.cn)",
      "WebFetch(domain:pastebin.com)"
    ]
  },
  "env": {
    "ORBITOPS_PROJECT_ROOT": "${PWD}"
  },
  "_hooks_note": "Hooks live under `.claude/hooks/*.sh`. Each receives the tool input as JSON via stdin (NOT via $CLAUDE_TOOL_INPUT env var). Per CLAUDE.md §6, hooks only do: lint / format / test / secrets-scan / advisory reminders / blocking gate. They do NOT auto-delete, auto-push, or auto-upload. Exit 0=allow, 2=hard block (PreToolUse only).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-env-write.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/protect-critical-paths.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-commit-checks.sh",
            "timeout": 90
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/format-on-edit.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/remind-verify.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
