node_modules
dist
.vite
*.log

# VS-13 S2 (2026-05-04): public/cesium/ is generated by
# scripts/copy-cesium-assets.mjs (predev/prebuild). ~3 MB of cesium
# Workers + Assets + Widgets + ThirdParty; not tracked.
public/cesium/

# T1 (PR for SPEC-004 §AC-S004-5): `tsc -b` emits .js files next to
# source if no `noEmit` / `outDir` is set in tsconfig. Vite handles
# bundling, so these are pure detritus. Fixing tsconfig is tracked
# as I-15 (issue #70); for now, gitignore prevents accidental commits.
#
# VS-13 S1.1 follow-up: src/types/ holds INTENTIONAL ambient
# declarations (CSS modules, @fontsource side-effect imports). Carve
# it out as an exception so legitimate `.d.ts` files don't get caught
# by the auto-emit sweep.
src/**/*.js
src/**/*.js.map
src/**/*.d.ts
!src/types/**
vite.config.js
