# OrbitOps Copilot — example env vars
# Copy to .env and fill in. NEVER commit .env.

# ── ntn-metrics-emulator ─────────────────────────────────
ORBITOPS_SCENARIO_PATH=/scenarios/beam-degradation.json
ORBITOPS_TICK_SECONDS=1
ORBITOPS_LOG_LEVEL=info
ORBITOPS_EMULATOR_PORT=8000

# ── copilot-api ──────────────────────────────────────────
COPILOT_API_PORT=8001
COPILOT_LLM_PROVIDER=mock        # mock | openai-compatible
COPILOT_TEMPERATURE=0.2
COPILOT_MAX_TOKENS=1024

# OpenAI-compatible endpoint (use any of: Ollama, vLLM, LM Studio, real OpenAI)
# Ollama default:    http://localhost:11434/v1
# vLLM default:      http://localhost:8000/v1  (clash with emulator! change one)
# LM Studio default: http://localhost:1234/v1
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen3.6:27b
OPENAI_API_KEY=ollama-no-key-needed   # placeholder; for real OpenAI use a real key

# ── digital-twin-ui ──────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8001
VITE_EMULATOR_BASE_URL=http://localhost:8000
VITE_PROMETHEUS_BASE_URL=http://localhost:9090

# ── observability ────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change-me-on-first-run

# ── voice-interface (optional, P1) ───────────────────────
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu

# ── runtime / build ──────────────────────────────────────
LOG_LEVEL=info
ENV=dev

# ── MCP server tokens (Sprint 1+; NOT installed in Sprint 0) ──
# These slots are placeholders. Do NOT fill until docs/mcp/03_mcp_install_plan.md
# triggers the corresponding install. .env is gitignored — never commit real tokens.
#
# GitHub fine-grained PAT, scope: this repo only, R-only on Contents/PR/Metadata/Issues
# GITHUB_TOKEN=
#
# Grafana service-account token, role=Viewer, scoped to OrbitOps folder
# GRAFANA_VIEWER_TOKEN=
#
# Prometheus bearer token (optional; only if Prom auth enabled)
# PROMETHEUS_TOKEN=
#
# context7 — kept user-level; do NOT enter project-level here
# (each contributor: claude mcp add --scope user context7 -- npx -y @upstash/context7-mcp --api-key …)
