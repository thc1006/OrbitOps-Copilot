{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbitops.local/schemas/copilot-response.schema.json",
  "title": "OrbitOps Copilot API Response (v2)",
  "description": "Schema for the response of POST /ask, /explain, /runbook from copilot-api. v2 (Sprint 1) per ADR-007.",
  "type": "object",
  "required": ["evidence", "status"],
  "additionalProperties": false,
  "properties": {
    "summary": { "type": ["string", "null"] },
    "likely_cause": { "type": ["string", "null"] },
    "evidence": {
      "type": "object",
      "required": ["metrics_used", "logs_used", "timestamp"],
      "additionalProperties": false,
      "properties": {
        "metrics_used": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "labels", "value", "timestamp"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "labels": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              },
              "value": { "type": "number" },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          }
        },
        "logs_used": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "line", "timestamp"],
            "additionalProperties": false,
            "properties": {
              "source": { "type": "string" },
              "line": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          }
        },
        "scenario_id": { "type": ["string", "null"] },
        "time_window_seconds": { "type": ["integer", "null"], "minimum": 0 },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "title", "body"],
        "additionalProperties": false,
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 }
        }
      }
    },
    "risk_if_ignored": { "type": ["string", "null"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "unknowns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": ["ok", "INSUFFICIENT_EVIDENCE", "REFUSED", "ERROR"]
    },
    "refusal_reason": { "type": ["string", "null"] },
    "error": { "type": ["string", "null"] }
  }
}
