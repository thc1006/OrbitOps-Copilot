{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbitops.local/schemas/groundstation-profile.schema.json",
  "title": "OrbitOps Ground Station Profile (Nephio stub v1)",
  "description": "Profile that DESCRIBES a B5G/NTN ground station for the OrbitOps Copilot demo. Sprint 1 scope: this is a *stub* — Nephio Porch / O-RAN O2 IMS / FOCOM lifecycle is NOT exercised. See ADR-005 and docs/future/nephio-o2ims-integration.md.",
  "type": "object",
  "required": [
    "station_id",
    "location",
    "supported_bands",
    "beam_profiles",
    "gateway_profiles",
    "observability_endpoints"
  ],
  "additionalProperties": false,
  "properties": {
    "station_id": {
      "type": "string",
      "pattern": "^gs-[a-z0-9-]{2,40}$",
      "description": "Stable identifier; matches the ground_station_id in scenario JSONs."
    },
    "location": {
      "type": "object",
      "required": ["lat", "lon", "alt_m", "country_code"],
      "additionalProperties": false,
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "alt_m": { "type": "number" },
        "country_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2."
        }
      }
    },
    "supported_bands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["S", "X", "Ku", "Ka", "Q", "V"]
      }
    },
    "beam_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["beam_id", "band", "boresight_az_deg", "boresight_el_deg", "hpbw_deg"],
        "additionalProperties": false,
        "properties": {
          "beam_id": { "type": "string", "minLength": 1 },
          "band": { "type": "string", "enum": ["S", "X", "Ku", "Ka", "Q", "V"] },
          "boresight_az_deg": { "type": "number", "minimum": 0, "maximum": 360 },
          "boresight_el_deg": { "type": "number", "minimum": 0, "maximum": 90 },
          "hpbw_deg": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 },
          "max_eirp_dbw": { "type": "number" }
        }
      }
    },
    "gateway_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["gateway_id", "role"],
        "additionalProperties": false,
        "properties": {
          "gateway_id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "enum": ["primary", "backup"] },
          "throughput_mbps": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "observability_endpoints": {
      "type": "object",
      "required": ["prometheus_url"],
      "additionalProperties": false,
      "properties": {
        "prometheus_url": { "type": "string", "format": "uri" },
        "grafana_url": { "type": "string", "format": "uri" },
        "loki_url": { "type": "string", "format": "uri" }
      }
    }
  }
}
