{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-sonnet-4-6",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(pwd)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(make:*)",
      "Bash(./verify.sh)",
      "Bash(./test.sh)",
      "Bash(scripts/bootstrap.sh)",
      "Bash(scripts/install-deps.sh)",
      "Bash(scripts/dev-up.sh)",
      "Bash(scripts/dev-down.sh)",
      "Bash(scripts/run-demo.sh)",
      "Bash(scripts/check-no-secrets.sh:*)",
      "Bash(scripts/package-zip.sh)",
      "Bash(python3 scripts/validate_schemas.py)",
      "Bash(python3 scripts/generate-scenarios.py:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(kustomize build:*)",
      "Bash(helm template:*)",
      "Bash(kubectl apply --dry-run=client:*)",
      "Bash(kubectl get:*)",
      "Bash(docker compose:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run test:*)",
      "Bash(npx vitest run:*)",
      "Bash(gh api:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git checkout main)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git tag:*)",
      "Bash(npm install:*)",
      "Bash(pip install:*)",
      "Bash(docker build:*)",
      "Bash(docker push:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(kind create:*)",
      "Bash(kind delete:*)",
      "Bash(helm install:*)",
      "Bash(helm upgrade:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(rm:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git config:*)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "WebFetch(domain:*.cn)",
      "WebFetch(domain:pastebin.com)"
    ]
  },
  "env": {
    "ORBITOPS_PROJECT_ROOT": "${PWD}"
  },
  "_hooks_note": "Hooks intentionally minimal. Permission `deny` rules already block destructive Bash; running heavyweight scans (check-no-secrets / verify.sh) on every Write/Edit is wasteful — those are gated at pre-commit (git hook) and CI instead. If you re-introduce hooks, remember PreToolUse handlers receive JSON via stdin, not via $CLAUDE_TOOL_INPUT env var.",
  "hooks": {
    "PreToolUse": [],
    "PostToolUse": [],
    "UserPromptSubmit": []
  }
}
